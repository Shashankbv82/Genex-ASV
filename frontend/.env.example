# Copy to .env.local for local overrides. Do not commit secrets or temporary IPs.
#
# When the Vite UI and FastAPI backend both run on the Raspberry Pi and you open
# the UI via that machine's hostname/Tailscale IP, leave these unset — the
# frontend defaults to the same hostname on port 8000.
#
# Set these when the UI runs on a different computer than the Pi backend:
#   VITE_API_BASE_URL=http://<pi-tailscale-ip>:8000/api
#   VITE_WS_URL=ws://<pi-tailscale-ip>:8000/ws/telemetry

# VITE_API_BASE_URL=
# VITE_WS_URL=
